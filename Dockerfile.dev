# Development image: runs the API through `air` for hot reload.
#
# Source code is bind-mounted at runtime (see docker-compose.yml), so this
# image only needs the Go toolchain + downloaded modules baked in. Do NOT
# `COPY . .` here — the bind mount supplies the source, and baking it in
# would just be overwritten (and go stale) at container start.
FROM golang:1.25-alpine

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app

# Pin air to a version known to build under this repo's Go toolchain (see
# go.mod). Bump together if the Go version here changes.
RUN go install github.com/air-verse/air@v1.61.7

COPY go.mod go.sum ./
RUN go mod download

EXPOSE 8000

CMD ["air", "-c", ".air.toml"]
